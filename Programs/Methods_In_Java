package Method1;

public class Demo {
	
	
	// Methods with No Return Type And No parameter
	
	void Add()
	{
		int a = 100;
		int b = 200;
		int c =a+b;
		System.out.println("Addition is :"+c);
	}
	void Sub()
	{
		int a = 300;
		int b = 20;
		int c = a-b;
		System.out.println("Substraction is :"+c);
	}
	void Mul()
	{
		int a = 435;
		int b = 10;
		int c = a*b;
		System.out.println("Multiplication is :"+c);
	}
	void Div()
	{
		int a = 500;
		int b = 10;
		int c = a/b;
		System.out.println("Division is :"+c);
	}
	public static void main(String[] args)
	{
		Demo D = new Demo();
		D.Add();
		D.Sub();
		D.Mul();
		D.Div();
	}

}
